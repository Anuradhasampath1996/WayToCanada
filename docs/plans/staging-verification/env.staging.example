# Staging-only Laravel env template.
# Copy to the STAGING host as backend/.env and fill placeholders.
# Never commit the filled file. Never copy production secrets into this file.
#
# Deploy and test tag rc-case-handling-phase-0-6 at
# ec670b0b833ff249e7d1474c2f1e04bf6b78ab8b — not a later documentation commit.

APP_NAME=RCICMASTER-STAGING
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.rcicmaster.ca

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=cws

# Separate staging databases — do not use production db_cws / db_lms / db_legal
DB_CWS_HOST=postgres
DB_CWS_PORT=5432
DB_CWS_DATABASE=db_cws_staging
DB_CWS_USERNAME=postgres
DB_CWS_PASSWORD=change-me-staging-only

DB_LMS_HOST=postgres
DB_LMS_PORT=5432
DB_LMS_DATABASE=db_lms_staging
DB_LMS_USERNAME=postgres
DB_LMS_PASSWORD=change-me-staging-only

DB_LEGAL_HOST=postgres
DB_LEGAL_PORT=5432
DB_LEGAL_DATABASE=db_legal_staging
DB_LEGAL_USERNAME=postgres
DB_LEGAL_PASSWORD=change-me-staging-only

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staging-safe email: log locally. Do not use production SES/SMTP.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply-staging@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Staging AWS / S3 — separate bucket and IAM. Leave blank until staging IAM exists.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
AWS_S3_BUCKET=wtc-staging-uploads
AWS_USE_PATH_STYLE_ENDPOINT=false

# Staging OAuth only. Leave blank if unused for smoke.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.rcicmaster.ca/api/v1/auth/google/callback

# Do not reuse production Twilio / WhatsApp tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_PROVIDER=meta
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=

GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=https://staging.rcicmaster.ca/api/v1/consultant/meeting-account/oauth/google/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://staging.rcicmaster.ca/api/v1/consultant/meeting-account/oauth/zoom/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://staging.rcicmaster.ca/api/v1/consultant/meeting-account/oauth/teams/callback
MICROSOFT_TENANT_ID=common

# Staging frontend URLs — replace with the real staging hostnames once DNS exists
PUBLIC_FRONTEND_URL=https://apply.staging.rcicmaster.ca
CONSULTANT_FRONTEND_URL=https://staging.rcicmaster.ca
CONSULTANT_DASHBOARD_URL=https://consultant.staging.rcicmaster.ca
FRONTEND_URL=https://staging.rcicmaster.ca
PUBLIC_DASHBOARD_URL=https://app.staging.rcicmaster.ca
ADMIN_DASHBOARD_URL=https://admin.staging.rcicmaster.ca

SANCTUM_STATEFUL_DOMAINS=staging.rcicmaster.ca,app.staging.rcicmaster.ca,consultant.staging.rcicmaster.ca,admin.staging.rcicmaster.ca,apply.staging.rcicmaster.ca

AUTH_GUARD=sanctum

# Optional low-cap staging key. Maple must remain recommend-only.
OPENAI_API_KEY=
LEGISLATION_OPENAI_ENABLED=false
WORKSPACE_AI_ENABLED=false
DOCUMENT_OCR_OPENAI_ENABLED=false

# Do not scrape the full public CICC register from staging
RCIC_SCRAPE_SEARCH_TERMS=
RCIC_SCRAPE_INCLUDE_RISIA=false
RCIC_SCRAPE_ENRICH_PROFILES=false

# Payments: leave production live keys unset. Sandbox only if marketing billing is tested.
PAYPAL_WEBHOOK_ID=
