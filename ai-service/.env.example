# ── OCR model ─────────────────────────────────────────────────────────────────
EASYOCR_GPU=false
CONFIDENCE_THRESHOLD=0.10

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── CORS (comma-separated origins, or * for all) ──────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3000

# ── Debug (set to true to include raw_text in response) ───────────────────────
DEBUG=false
