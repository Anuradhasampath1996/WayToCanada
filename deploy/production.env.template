# Production environment template — DO NOT commit real secrets to git.
# Copy values to GitHub → Settings → Secrets → Actions:
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#
# On deploy, bootstrap-prod-env.sh patches backend/.env automatically.
# Database data is never modified by this script.

APP_ENV=production
APP_DEBUG=false
APP_URL=http://www.lightersmenia.com

DB_CWS_HOST=postgres
DB_CWS_PORT=5432
DB_CWS_DATABASE=db_cws
DB_CWS_USERNAME=postgres
DB_CWS_PASSWORD=secret

PUBLIC_FRONTEND_URL=http://www.lightersmenia.com
CONSULTANT_FRONTEND_URL=http://consultant.lightersmenia.com
CONSULTANT_DASHBOARD_URL=http://portal.lightersmenia.com

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://www.lightersmenia.com/api/v1/auth/google/callback

# Google Cloud Console → Authorized redirect URIs (add both):
#   http://localhost:8000/api/v1/auth/google/callback
#   http://www.lightersmenia.com/api/v1/auth/google/callback
