APP_NAME=RCICMASTER
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=cws

# â”€â”€ CWS (Users / Auth / Consultant Workspace) â”€â”€
# LOCAL DEV: use Windows PostgreSQL â€” see scripts/LOCAL-DEV-DATABASE.md
DB_CWS_HOST=127.0.0.1
DB_CWS_PORT=5432
DB_CWS_DATABASE=db_cws
DB_CWS_USERNAME=postgres
DB_CWS_PASSWORD=secret

# â”€â”€ LMS (Learning Management System) â”€â”€
DB_LMS_HOST=127.0.0.1
DB_LMS_PORT=5432
DB_LMS_DATABASE=db_lms
DB_LMS_USERNAME=postgres
DB_LMS_PASSWORD=secret

DB_ACADEMY_HOST=127.0.0.1
DB_ACADEMY_PORT=5432
DB_ACADEMY_DATABASE=db_academy
DB_ACADEMY_USERNAME=postgres
DB_ACADEMY_PASSWORD=secret
ACADEMY_MEDIA_DISK=local

# â”€â”€ Legal Hub (AI IRPA/IRPR Research) â”€â”€
DB_LEGAL_HOST=127.0.0.1
DB_LEGAL_PORT=5432
DB_LEGAL_DATABASE=db_legal
DB_LEGAL_USERNAME=postgres
DB_LEGAL_PASSWORD=secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# â”€â”€ Mail (SMTP) â€” optional; SES uses AWS keys below â”€â”€
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# â”€â”€ Mail (use SES in production for PIPEDA compliance) â”€â”€
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@rcicmaster.ca"
MAIL_FROM_NAME="${APP_NAME}"

# â”€â”€ AWS (Canada Central â€” ca-central-1) â”€â”€
# In production: values come from AWS Secrets Manager
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
AWS_S3_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# â”€â”€ Google OAuth (Socialite) â”€â”€
# Production: set GitHub Secrets GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (never commit real values).
# Production redirect URI: http://www.rcicmaster.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# â”€â”€ Twilio WhatsApp (notification + agreement reminders) â”€â”€
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# WhatsApp â€” Meta Cloud API (primary) with optional Twilio fallback
WHATSAPP_PROVIDER=meta
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_CLOUD_LANGUAGE=en
WHATSAPP_CLOUD_CONSULTANT_TEMPLATE=wtc_consultant_alert
WHATSAPP_CLOUD_CLIENT_TEMPLATE=wtc_client_alert
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=

# â”€â”€ Video meetings OAuth (Google Meet / Zoom / Teams) â”€â”€
# Google: enable Calendar API; redirect = meeting-account/oauth/google/callback
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=http://localhost:8000/api/v1/consultant/meeting-account/oauth/google/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/v1/consultant/meeting-account/oauth/zoom/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/consultant/meeting-account/oauth/teams/callback
MICROSOFT_TENANT_ID=common

# â”€â”€ Frontend URLs (local dev ports) â”€â”€
PUBLIC_FRONTEND_URL=http://localhost:3000
CONSULTANT_FRONTEND_URL=http://localhost:3003
CONSULTANT_DASHBOARD_URL=http://localhost:3005

# â”€â”€ Sanctum / CORS â”€â”€
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:3002,localhost:3003,localhost:3005,localhost:8000
FRONTEND_URL=http://localhost:3000

# â”€â”€ Auth â”€â”€
AUTH_GUARD=sanctum

# â”€â”€ OpenAI â€” Legislation Hub (analyze & linkify cross-references) â”€â”€
OPENAI_API_KEY=
LEGISLATION_OPENAI_ENABLED=false
LEGISLATION_OPENAI_MODEL=gpt-4o-mini
LEGISLATION_BATCH_SIZE=10
LEGISLATION_REQUEST_DELAY_MS=300
LEGISLATION_OPENAI_CHUNK_MAX=4000

# Document scan (passport/ID) â€” same OPENAI_API_KEY via Vision (falls back to EasyOCR)
DOCUMENT_OCR_OPENAI_ENABLED=true
DOCUMENT_OCR_OPENAI_MODEL=
DOCUMENT_OCR_OPENAI_TIMEOUT=60

# â”€â”€ RCIC Academy AI Content Studio (admin drafts only; never publishes) â”€â”€
ACADEMY_AI_ENABLED=true
ACADEMY_OPENAI_API_KEY=
ACADEMY_AI_REASONING_MODEL=gpt-4o-2024-08-06
ACADEMY_AI_FAST_MODEL=gpt-4o-mini-2024-07-18
ACADEMY_AI_VALIDATION_MODEL=
ACADEMY_AI_IMAGE_MODEL=gpt-image-1
ACADEMY_AI_TIMEOUT_SECONDS=120
ACADEMY_AI_MAX_QUESTIONS_PER_JOB=600
ACADEMY_AI_MAX_SOURCE_CHARS=80000
ACADEMY_AI_BATCH_SIZE=10
ACADEMY_AI_MONTHLY_BUDGET_USD=250
ACADEMY_AI_BUDGET_WARN_PERCENT=80
ACADEMY_AI_IMAGE_LIMIT_PER_JOB=8
ACADEMY_MANUS_ENABLED=false
MANUS_API_KEY=
ACADEMY_MANUS_FALLBACK=openai
ACADEMY_MANUS_WEBHOOK_URL=

# â”€â”€ OpenAI â€” Workspace AI Advisor (consultant client workspace) â”€â”€
WORKSPACE_AI_ENABLED=false
WORKSPACE_AI_MODEL=gpt-4o-mini
WORKSPACE_AI_TIMEOUT=90

# â”€â”€ CICC public register scrape (admin RCIC sync) â”€â”€
# Default "*" = blank last-name search (full public register, ~17k RCICs).
RCIC_SCRAPE_DELAY_MS=1200
RCIC_SCRAPE_SEARCH_TERMS=*
RCIC_SCRAPE_INCLUDE_RISIA=true
RCIC_SCRAPE_ENRICH_PROFILES=true
RCIC_SCRAPE_ENRICH_ONLY_MISSING=true
RCIC_SCRAPE_ENRICH_SEARCH=false
RCIC_SCRAPE_HTTP_RETRIES=6
RCIC_SCRAPE_429_BACKOFF=30
RCIC_SCRAPE_MAX_SYSTEMIC_FAILURES=8
RCIC_SCRAPE_HTTP_TIMEOUT=60

# Platform subscription billing (Stripe Smart Retries remain the only retry owner)
SUBSCRIPTION_GRACE_DAYS=3

# AI Course Factory
COURSE_FACTORY_ENABLED=true
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
MANUS_API_KEY=
MANUS_API_BASE_URL=https://api.manus.ai
AI_COURSE_QUESTION_BANK_MULTIPLIER=5
AI_COURSE_MIN_QUESTION_BANK_SIZE=500
AI_COURSE_MAX_QUESTION_BANK_SIZE=2000
AI_COURSE_QUESTION_BATCH_SIZE=20
AI_COURSE_MAX_RETRIES=3
