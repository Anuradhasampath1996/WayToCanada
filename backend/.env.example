APP_NAME=WayToCanada
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=cws

# ── CWS (Users / Auth / Consultant Workspace) ──
# LOCAL DEV: use Windows PostgreSQL — see scripts/LOCAL-DEV-DATABASE.md
DB_CWS_HOST=127.0.0.1
DB_CWS_PORT=5432
DB_CWS_DATABASE=db_cws
DB_CWS_USERNAME=postgres
DB_CWS_PASSWORD=secret

# ── LMS (Learning Management System) ──
DB_LMS_HOST=127.0.0.1
DB_LMS_PORT=5432
DB_LMS_DATABASE=db_lms
DB_LMS_USERNAME=postgres
DB_LMS_PASSWORD=secret

# ── Legal Hub (AI IRPA/IRPR Research) ──
DB_LEGAL_HOST=127.0.0.1
DB_LEGAL_PORT=5432
DB_LEGAL_DATABASE=db_legal
DB_LEGAL_USERNAME=postgres
DB_LEGAL_PASSWORD=secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (SMTP) — optional; SES uses AWS keys below ──
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# ── Mail (use SES in production for PIPEDA compliance) ──
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@rcicmaster.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (Canada Central — ca-central-1) ──
# In production: values come from AWS Secrets Manager
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
AWS_S3_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Google OAuth (Socialite) ──
# Production: set GitHub Secrets GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (never commit real values).
# Production redirect URI: http://www.rcicmaster.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Twilio WhatsApp (notification + agreement reminders) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Video meetings OAuth (Google Meet / Zoom / Teams) ──
# Google: enable Calendar API; redirect = meeting-account/oauth/google/callback
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=http://localhost:8000/api/v1/consultant/meeting-account/oauth/google/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/v1/consultant/meeting-account/oauth/zoom/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/consultant/meeting-account/oauth/teams/callback
MICROSOFT_TENANT_ID=common

# ── Frontend URLs (local dev ports) ──
PUBLIC_FRONTEND_URL=http://localhost:3000
CONSULTANT_FRONTEND_URL=http://localhost:3003
CONSULTANT_DASHBOARD_URL=http://localhost:3005

# ── Sanctum / CORS ──
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:3002,localhost:3003,localhost:3005,localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Auth ──
AUTH_GUARD=sanctum

# ── OpenAI — Legislation Hub (analyze & linkify cross-references) ──
OPENAI_API_KEY=
LEGISLATION_OPENAI_ENABLED=false
LEGISLATION_OPENAI_MODEL=gpt-4o-mini
LEGISLATION_OPENAI_CHUNK_MAX=4000
